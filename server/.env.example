# NimCare API environment variables. Copy to .env and fill in for local dev.
# Never commit the real .env file.

# HTTP port for the API server.
PORT=8787

# development | production
NODE_ENV=development

# SQLite dev database path. Production should use a real managed database
# instead (see TRD.md — this is an explicit, disclosed deployment gap).
DATABASE_PATH=./data/nimcare.db

# Nimiq JSON-RPC endpoint used for server-side transaction verification.
# Nimiq's own docs (https://nimiq.dev/rpc/integrations/raw) document
# https://rpc.nimiqwatch.com as an open server for development/testing.
# If unset, CareDrops stay in a disclosed "verification pending" state
# instead of being falsely marked verified.
NIMIQ_RPC_URL=https://rpc.nimiqwatch.com

# Optional: only enforced when set. Prevents a testnet payment from ever
# verifying a mainnet CareDrop (or vice versa). Leave unset if you haven't
# confirmed the networkId your chosen RPC/network actually returns.
NIMIQ_NETWORK_ID=

# The exact origin NimCare is served from in this environment. Used to
# domain-bind the wallet-login challenge message server-side (never trust an
# Origin the client claims). Example: https://nimcare.example.com
APP_ORIGIN=http://localhost:5173 (dev)

# Comma-separated list of origins allowed to call this API via CORS.
# Required in production — with NODE_ENV=production and this unset, no
# cross-origin requests are allowed at all (fails closed, not open).
ALLOWED_ORIGINS=
