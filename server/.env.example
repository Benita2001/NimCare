# NimCare API environment variables. Copy to .env and fill in for local dev.
# Never commit the real .env file.

# HTTP port for the API server.
PORT=8787

# SQLite dev database path. Production should use a real managed database
# instead (see TRD.md — this is an explicit, disclosed deployment gap).
DATABASE_PATH=./data/nimcare.db

# Nimiq JSON-RPC endpoint used for server-side transaction verification.
# No public default is documented (see MEMORY.md Spike S4) — point this at
# your own Nimiq node's --rpc endpoint, or a trusted provided endpoint.
# If unset, CareDrops stay in a disclosed "verification pending" state
# instead of being falsely marked verified.
NIMIQ_RPC_URL=
